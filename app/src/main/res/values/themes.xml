<resources>
    <color name="ic_launcher_bg">#1E1E24</color>
    <style name="AppTheme" parent="android:Theme.Material.Light.DarkActionBar" />
    <!-- Picked at runtime from the App theme setting (see AppTheme.kt). -->
    <style name="AppTheme.Light" parent="android:Theme.DeviceDefault.Light" />

    <!-- AMOLED dark: true black backgrounds (pixels off), near-black popups so they still stand out. -->
    <style name="AppTheme.Dark" parent="android:Theme.DeviceDefault">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:colorPrimary">@android:color/black</item>
        <item name="android:colorPrimaryDark">@android:color/black</item>
        <!-- Ticks, switches, sliders, buttons: must stand out on black. -->
        <item name="android:colorAccent">#FF8AB4F8</item>
        <item name="android:colorControlActivated">#FF8AB4F8</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:alertDialogTheme">@style/AmoledDialog</item>
        <item name="android:datePickerDialogTheme">@style/AmoledDialog</item>
        <item name="android:timePickerDialogTheme">@style/AmoledDialog</item>
    </style>

    <style name="AmoledDialog" parent="android:Theme.DeviceDefault.Dialog.Alert">
        <item name="android:colorBackground">#FF121212</item>
        <item name="android:colorAccent">#FF8AB4F8</item>
        <item name="android:colorControlActivated">#FF8AB4F8</item>
        <item name="android:windowBackground">@drawable/amoled_dialog_bg</item>
    </style>
</resources>
